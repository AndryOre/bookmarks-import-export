{
  "name": "bookmarks-import-export",
  "description": "Browser extension to import and export bookmarks as HTML, JSON or CSV, with selective export, restore and scheduled backups.",
  "keywords": [
    "browser-extension",
    "bookmarks",
    "csv",
    "chrome",
    "wxt"
  ],
  "homepage": "https://github.com/AndryOre/bookmarks-import-export",
  "bugs": {
    "url": "https://github.com/AndryOre/bookmarks-import-export/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AndryOre/bookmarks-import-export.git"
  },
  "license": "MIT",
  "author": "Andry Orellana <me@andryore.dev>",
  "private": true,
  "version": "1.7.0",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": "1.4.2"
  },
  "scripts": {
    "clean": "rm -rf .output .wxt node_modules",
    "cache:clear": "rm -rf .eslintcache node_modules/.cache",
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run knip",
    "fix": "bun run format:write && bun run lint:fix && bun run typecheck",
    "ci:local": "bun install --frozen-lockfile && bun run check && bun run lint:docs && bun run test",
    "typecheck": "tsc --noEmit",
    "knip": "bunx knip",
    "lint": "bunx eslint . --max-warnings=0 --cache --cache-strategy content",
    "lint:docs": "bun scripts/lint-docs.ts",
    "lint:fix": "bunx eslint . --fix --max-warnings=0 --cache --cache-strategy content",
    "format:check": "bunx --bun prettier --check \"**/*.{ts,tsx,js,jsx,mjs,mdx,json,json5,md,css,scss,yml,yaml}\" --cache",
    "format:write": "bunx --bun prettier --write \"**/*.{ts,tsx,js,jsx,mjs,mdx,json,json5,md,css,scss,yml,yaml}\" --cache",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "wxt build && playwright test",
    "postinstall": "wxt prepare",
    "prepare": "bunx --bun husky"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/geist": "^5.2.8",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@wxt-dev/i18n": "^0.2.5",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.49.0",
    "papaparse": "^5.5.3",
    "radix-ui": "^1.4.3",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@playwright/test": "^1.63.0",
    "@shadcn/lint": "^0.2.0",
    "@tailwindcss/vite": "^4.2.4",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/bun": "^1.4.2",
    "@types/chrome": "^0.3.4",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^5.0.3",
    "@vitest/eslint-plugin": "^1.6.27",
    "@wxt-dev/auto-icons": "^1.1.1",
    "@wxt-dev/browser": "^0.3.4",
    "@wxt-dev/module-react": "^1.2.2",
    "bun-types": "^1.4.2",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^65.0.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unicorn": "^76.0.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.1",
    "knip": "^6.39.0",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn": "^4.21.1",
    "tailwindcss": "^4.2.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3",
    "wxt": "^0.21.4"
  }
}
